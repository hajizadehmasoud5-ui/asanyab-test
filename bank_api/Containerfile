FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt
COPY app.py /app/app.py
COPY app_geo.py /app/app_geo.py
COPY schema.sql /app/schema.sql
COPY seed_pilot.py /app/seed_pilot.py
COPY seed_catalog.py /app/seed_catalog.py
COPY cleanup_catalog.py /app/cleanup_catalog.py
COPY normalize_services.py /app/normalize_services.py
COPY normalize_geography.py /app/normalize_geography.py
COPY fix_geo_aliases.py /app/fix_geo_aliases.py
COPY backfill_districts.py /app/backfill_districts.py
COPY ingest_iionline_iran.py /app/ingest_iionline_iran.py
COPY ingest_dana_public.py /app/ingest_dana_public.py
COPY ingest_asia_official.py /app/ingest_asia_official.py
COPY refresh_all.py /app/refresh_all.py
COPY import_discovered.py /app/import_discovered.py
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app_geo:app", "--host", "0.0.0.0", "--port", "8000"]

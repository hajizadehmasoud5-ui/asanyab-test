FROM python:3.12-slim
WORKDIR /app
COPY bank_api/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt
COPY marketplace_test_api/app.py /app/app.py
COPY marketplace_test_api/schema.sql /app/schema.sql
COPY bank_api/marketplace.py /app/marketplace.py
COPY bank_api/marketplace_smoke.py /app/marketplace_smoke.py
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

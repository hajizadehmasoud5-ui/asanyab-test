FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY . /usr/share/nginx/html
RUN sed -i 's#</body>#<script src="implant-intake-secure.js"></script></body>#' /usr/share/nginx/html/implant-intake.html \
 && sed -i 's#</body>#<script src="implant-doctor-patient.js"></script></body>#' /usr/share/nginx/html/implant-doctor.html
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/health.json >/dev/null || exit 1
